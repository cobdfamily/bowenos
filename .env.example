# Flake target role: compute or computeplusstorage
# (You can also set TARGET=compute in your shell/just command.)
TARGET=computeplusstorage
ROLE=$TARGET

# Identity
HOSTNAME=bowenos
HOSTID=deadbeef   # 8 hex chars required for ZFS

# Locale/time
TIMEZONE=America/Vancouver
LOCALE=en_CA.UTF-8

# Boot disks (required by disko)
# Provide by-id basenames or full /dev/... paths
BOOTA_BYID=nvme-EXAMPLE_DISK_A
BOOTB_BYID=nvme-EXAMPLE_DISK_B

# Admin user
ADMIN_USER=leonard

# SSH (choose ONE)
SSH_PUBKEY="ssh-ed25519 AAAA... your@key"
# SSH_PUBKEY_FILE=/path/to/id_ed25519.pub

# Safeguards / policy
SUDO_NEEDS_PASSWORD=false
ALLOW_NO_SSH_KEY=false

# Optional: if you want efibootmgr to use a specific disk path
# BOOTB_DISK_PATH=/dev/disk/by-id/nvme-EXAMPLE_DISK_B
