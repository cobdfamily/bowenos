#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
TARGET_BIN="${SCRIPT_DIR}/flakes/installer/bin/bowenos"

if [[ ! -x "${TARGET_BIN}" ]]; then
  echo "I sadly can't find the installer binary or it is not executable: ${TARGET_BIN}" >&2
  echo "No worries. I'm now downloading a new copy of the installer..." >&2
  git clone https://github.com/cobdfamily /tmp/installer
  cd /tmp/installer
fi

echo "Running the BowenOS tools..."
exec "${TARGET_BIN}" "$@"
